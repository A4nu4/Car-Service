# Copy to .env and fill in. .env is git-ignored: never commit real secrets.

# --- Database ---
DB_NAME=car_rental
DB_USERNAME=car_rental
DB_PASSWORD=
# For running the jar outside Docker:
# DB_URL=jdbc:postgresql://localhost:5432/car_rental

# --- Security ---
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=
# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- First admin account (created on startup if missing; min. 12-character password) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# --- Optional ---
# dev = demo data + Swagger UI, prod = no demo data, Swagger off unless API_DOCS_ENABLED=true
SPRING_PROFILES_ACTIVE=dev
RENTAL_TIME_ZONE=Europe/Berlin
API_PORT=8080
API_DOCS_ENABLED=false
